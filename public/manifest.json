{
  "manifest_version": 3,
  "name": "Unblur Mobbin",
  "version": "1.4",
  "description": "Unblur and restore full-resolution screens on Mobbin",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://mobbin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mobbin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  }
}
